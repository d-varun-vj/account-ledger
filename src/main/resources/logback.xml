<?xml version="1.0" encoding="UTF-8"?>

<configuration debug="true">
    <appender name="consoleLogger" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d %-5level %logger{35} [accountLedger-v1] - %msg %n</pattern>
        </encoder>
    </appender>
    <logger level="INFO" name="com.pismo" additivity="false">
        <appender-ref ref="consoleLogger"/>
    </logger>
    <root>
        <level value="INFO"/>
        <appender-ref ref="consoleLogger"/>
    </root>

</configuration>

